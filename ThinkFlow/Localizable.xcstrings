    "하나든 열 개든 괜찮아요. 줄바꿈으로 생각을 구분하세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna myšlenka, nebo deset – nevadí. Oddělujte je novými řádky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én tanke eller ti – det er lige meget. Adskil dem med linjeskift."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Gedanke oder zehn – beides ist okay. Trenne sie mit Zeilenumbrüchen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία σκέψη ή δέκα, δεν πειράζει. Χωρίστε τις με αλλαγή γραμμής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One thought or ten, either is fine. Separate them with line breaks."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One thought or ten, either is fine. Separate them with line breaks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da igual si es una idea o diez. Sepáralas con saltos de línea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi ajatus tai kymmenen, ihan sama. Erota ne rivinvaihdoilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une idée ou dix, peu importe. Séparez-les par des retours à la ligne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu pikiran atau sepuluh, tidak masalah. Pisahkan dengan baris baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pensiero o dieci, va bene lo stesso. Separali con un a capo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つでも10個でも大丈夫。改行で区切ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하나든 열 개든 괜찮아요. 줄바꿈으로 생각을 구분하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én tanke eller ti – det spiller ingen rolle. Skill dem med linjeskift."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén gedachte of tien, het maakt niet uit. Scheid ze met regelafbrekingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna myśl czy dziesięć – bez różnicy. Rozdzielaj je enterem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma ideia ou dez, tanto faz. Separe com quebras de linha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хоть одну мысль, хоть десять. Разделяйте их переводом строки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tanke eller tio – det spelar ingen roll. Avgränsa dem med radbrytningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะเขียนข้อเดียวหรือสิบข้อก็ได้ ใช้การขึ้นบรรทัดใหม่แยกแต่ละความคิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir düşünce de olur, on tane de. Satır başıyla ayır."
          }
        },
        "vi" : {
