    "'%@' 스레드의 모든 메모와 브릿지가 삭제됩니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Notizen und der Brückensatz von „%@“ werden gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All notes and the bridge in “%@” will be deleted."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All notes and the bridge in “%@” will be deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las notas y la frase puente del hilo «%@»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」のメモと区切りの一文がすべて削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' 스레드의 모든 메모와 브릿지가 삭제됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”线程中的所有备忘和衔接句都将被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」思考串中的所有備忘和銜接句都會被刪除。"
          }
        }
      }
    },
    "'이어서 생각하기'를 눌러 첫 기록을 남겨보세요" : {
