        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A que você escolher vira um fio de pensamento na hora. As demais ficam guardadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранная мысль сразу станет цепочкой размышлений. Остальные будут сохранены."
          }
        },
        "sv" : {
          "stringUnit" : {
