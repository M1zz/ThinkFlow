    "기세가 있을 때 끊어두세요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skončete, dokud to jde"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop, mens det går godt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hör auf, solange es läuft"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σταματήστε όσο έχετε φόρα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop while you’re on a roll"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop while you’re on a roll"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mientras vas lanzado"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopeta, kun vauhti vielä kantaa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez-vous en plein élan"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berhenti saat sedang lancar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermati finché sei ispirato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勢いのあるうちに区切りましょう"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기세가 있을 때 끊어두세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopp mens det går bra"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop als het lekker loopt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przerwij, gdy idzie dobrze"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare enquanto está no embalo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановитесь на подъёме"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluta medan det flyter på"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยุดตอนกำลังมีไฟ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akıştayken dur"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy dừng khi đang hứng khởi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趁思路正顺时停下"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趁思緒正順時停下"
          }
        }
      }
    },
    "기세가 있을 때 끊어둔 미완성 문장. 다음에 열면 뇌가 자동으로 이어받습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedokončená věta, kterou jste nechali v plném tahu. Až aplikaci příště otevřete, mysl na ni sama naváže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En uafsluttet sætning, du efterlod i medvind. Næste gang du åbner appen, samler din hjerne tråden op af sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein unfertiger Satz, den du im Schwung hinterlassen hast. Beim nächsten Öffnen greift dein Kopf den Faden von selbst wieder auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια ημιτελής πρόταση που αφήσατε εν μέσω έμπνευσης. Την επόμενη φορά που θα ανοίξετε την εφαρμογή, το μυαλό σας θα πιάσει μόνο του το νήμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An unfinished sentence you left while the momentum was there. Next time you open the app, your brain picks it right up."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An unfinished sentence you left while the momentum was there. Next time you open the app, your brain picks it right up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una frase inacabada que dejaste mientras tenías impulso. La próxima vez que abras la app, tu mente retomará el hilo sola."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesken jäänyt lause, jonka jätit vauhdissa. Kun avaat sovelluksen seuraavan kerran, mielesi tarttuu langanpäähän itsestään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une phrase inachevée laissée en plein élan. À la prochaine ouverture, votre esprit reprendra le fil tout seul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalimat yang sengaja kamu biarkan menggantung saat sedang lancar. Saat membuka aplikasi lagi, pikiranmu akan menyambungnya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una frase lasciata a metà mentre eri ispirato. La prossima volta che apri l’app, la tua mente riprenderà il filo da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勢いのあるうちに残した書きかけの一文です。次に開くと、頭が自然に続きを思い出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기세가 있을 때 끊어둔 미완성 문장. 다음에 열면 뇌가 자동으로 이어받습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En uferdig setning du lot stå mens du var i flyt. Neste gang du åpner appen, tar hjernen opp tråden av seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een onafgemaakte zin die je liet staan toen het lekker liep. De volgende keer dat je de app opent, pakt je brein de draad vanzelf weer op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedokończone zdanie zostawione w pełnym rozpędzie. Gdy następnym razem otworzysz aplikację, umysł sam podejmie wątek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma frase inacabada que você deixou no embalo. Quando abrir o app de novo, sua mente retoma o fio sozinha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незаконченная фраза, оставленная на подъёме. Когда вы откроете приложение снова, мысль подхватится сама."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ofullbordad mening som du lämnade medan det flöt på. Nästa gång du öppnar appen tar hjärnan upp tråden av sig själv."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประโยคที่เขียนค้างไว้ตอนกำลังมีไฟ เมื่อเปิดแอปครั้งหน้า สมองจะต่อความคิดได้เองโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam akıştayken yarım bıraktığın bir cümle. Uygulamayı bir sonraki açışında zihnin kaldığın yerden kendiliğinden devam eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một câu bỏ dở khi bạn đang hứng khởi. Lần sau mở ứng dụng, đầu óc bạn sẽ tự nối tiếp mạch nghĩ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趁思路顺畅时留下的未完句子。下次打开时，大脑会自然接着往下想。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趁思緒順暢時留下的未完句子。下次打開時，大腦會自然接著往下想。"
          }
        }
      }
    },
