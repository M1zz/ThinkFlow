    "생각이 바뀔 때마다 따로 추가하면 나중에 정리하기 쉬워요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když každou novou myšlenku přidáte zvlášť, bude se vám pak snáz třídit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du tilføjer hver ny tanke for sig, bliver det lettere at ordne dem bagefter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du jeden neuen Gedanken einzeln hinzufügst, kannst du später leichter ordnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν προσθέτετε κάθε νέα σκέψη ξεχωριστά, θα είναι πιο εύκολο να τις οργανώσετε αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding a thought each time your thinking shifts makes it easier to organise later."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding a thought each time your thinking shifts makes it easier to organise later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si añades cada idea por separado cuando cambie tu forma de pensar, será más fácil ordenarlas después."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun lisäät jokaisen uuden ajatuksen erikseen, niiden järjestäminen myöhemmin on helpompaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
