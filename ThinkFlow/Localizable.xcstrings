          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pick becomes a thought thread right away. The rest are saved for later."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pick becomes a thought thread right away. The rest are saved for later."
          }
