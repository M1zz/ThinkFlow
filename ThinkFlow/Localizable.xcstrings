    "펼치는 아이폰에서 넓은 화면을 두 쪽으로 나눠 써요." : {
      "comment" : "Roadmap item detail: foldable iPhone layout",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Širokou obrazovku skládacího iPhonu využijte jako dva panely vedle sebe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug den brede skærm på en foldbar iPhone som to ruder side om side."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze den großen Bildschirm eines faltbaren iPhones als zwei Spalten nebeneinander."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε τη μεγάλη οθόνη ενός αναδιπλούμενου iPhone ως δύο πάνελ δίπλα-δίπλα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the wide screen of a foldable iPhone as two side-by-side panes."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the wide screen of a foldable iPhone as two side-by-side panes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la pantalla amplia de un iPhone plegable como dos paneles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä taittuvan iPhonen leveää näyttöä kahtena vierekkäisenä ruutuna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profitez du grand écran d’un iPhone pliable en deux volets côte à côte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
