        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기세가 있을 때 끊어두세요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趁思路正顺时停下"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趁思緒正順時停下"
          }
        }
      }
    },
    "기세가 있을 때 끊어둔 미완성 문장. 다음에 열면 뇌가 자동으로 이어받습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein unfertiger Satz, den du im Schwung hinterlassen hast. Beim nächsten Öffnen greift dein Kopf den Faden von selbst wieder auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An unfinished sentence you left while the momentum was there. Next time you open the app, your brain picks it right up."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An unfinished sentence you left while the momentum was there. Next time you open the app, your brain picks it right up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una frase inacabada que dejaste mientras tenías impulso. La próxima vez que abras la app, tu mente retomará el hilo sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勢いのあるうちに残した書きかけの一文です。次に開くと、頭が自然に続きを思い出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기세가 있을 때 끊어둔 미완성 문장. 다음에 열면 뇌가 자동으로 이어받습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趁思路顺畅时留下的未完句子。下次打开时，大脑会自然接着往下想。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趁思緒順暢時留下的未完句子。下次打開時，大腦會自然接著往下想。"
          }
        }
      }
    },
    "기세가 있을 때 문장을 끊어두세요.\n다음에 열면 뇌가 자동으로 이어받습니다." : {
