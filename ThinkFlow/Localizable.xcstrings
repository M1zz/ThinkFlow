    "막혀서 멈추는 게 아니라, 아직 쓸 게 있을 때 여기서 끊어두세요.\n다음에 열면 뇌가 자동으로 이어받습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nekončete proto, že se zaseknete, ale dokud ještě máte co psát.\nAž aplikaci příště otevřete, mysl na to sama naváže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop ikke fordi du sidder fast, men mens du stadig har noget at skrive.\nNæste gang du åbner appen, samler din hjerne tråden op af sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hör nicht auf, weil du feststeckst, sondern solange du noch etwas zu schreiben hast.\nBeim nächsten Öffnen greift dein Kopf den Faden von selbst wieder auf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μη σταματάτε επειδή κολλήσατε, αλλά όσο έχετε ακόμα κάτι να γράψετε.\nΤην επόμενη φορά που θα ανοίξετε την εφαρμογή, το μυαλό σας θα πιάσει μόνο του το νήμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don’t stop because you’re stuck — stop while you still have more to write.\nNext time you open the app, your brain picks it right up."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don’t stop because you’re stuck — stop while you still have more to write.\nNext time you open the app, your brain picks it right up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pares porque te atasques, sino mientras aún tengas algo que escribir.\nLa próxima vez que abras la app, tu mente retomará el hilo sola."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älä lopeta siksi, että jumiudut, vaan kun sinulla on vielä jotain kirjoitettavaa.\nKun avaat sovelluksen seuraavan kerran, mielesi tarttuu langanpäähän itsestään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne vous arrêtez pas parce que vous êtes bloqué, mais tant qu’il vous reste des choses à écrire.\nÀ la prochaine ouverture, votre esprit reprendra le fil tout seul."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berhentilah bukan karena buntu, tetapi saat kamu masih punya yang ingin ditulis.\nSaat membuka aplikasi lagi, pikiranmu akan menyambungnya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non fermarti perché sei bloccato, ma finché hai ancora qualcosa da scrivere.\nLa prossima volta che apri l’app, la tua mente riprenderà il filo da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行き詰まって止めるのではなく、まだ書けるうちにここで区切りましょう。\n次に開くと、頭が自然に続きを思い出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "막혀서 멈추는 게 아니라, 아직 쓸 게 있을 때 여기서 끊어두세요.\n다음에 열면 뇌가 자동으로 이어받습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke stopp fordi du står fast, men mens du fortsatt har noe å skrive.\nNeste gang du åpner appen, tar hjernen opp tråden av seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop niet omdat je vastzit, maar zolang je nog iets te schrijven hebt.\nDe volgende keer dat je de app opent, pakt je brein de draad vanzelf weer op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie przerywaj dlatego, że utknąłeś, lecz póki jeszcze masz co pisać.\nGdy następnym razem otworzysz aplikację, umysł sam podejmie wątek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não pare porque travou, e sim enquanto ainda tem o que escrever.\nQuando abrir o app de novo, sua mente retoma o fio sozinha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останавливайтесь не когда упёрлись в стену, а пока ещё есть что писать.\nКогда вы откроете приложение снова, мысль подхватится сама."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluta inte för att du kört fast, utan medan du fortfarande har något att skriva.\nNästa gång du öppnar appen tar hjärnan upp tråden av sig själv."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อย่าหยุดเพราะติดขัด แต่ให้หยุดตอนที่ยังมีเรื่องจะเขียนอีก\nเมื่อเปิดแอปครั้งหน้า สมองจะต่อความคิดได้เองโดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tıkandığın için değil, yazacak bir şeyin hâlâ varken dur.\nUygulamayı bir sonraki açışında zihnin kaldığın yerden kendiliğinden devam eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đừng dừng vì bí, mà hãy dừng khi bạn vẫn còn điều muốn viết.\nLần sau mở ứng dụng, đầu óc bạn sẽ tự nối tiếp mạch nghĩ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不是卡住了才停，而是趁着还有话可写时，在这里停下。\n下次打开时，大脑会自然接着往下想。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不是卡住了才停，而是趁著還有話可寫時，在這裡停下。\n下次打開時，大腦會自然接著往下想。"
          }
        }
      }
    },
    "머릿속 생각을 적어 새 스레드를 만듭니다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napište, co vám běží hlavou, a vytvořte nové vlákno"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv ned, hvad du går og tænker på, og opret en ny tråd"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib auf, was dir durch den Kopf geht, und erstelle einen neuen Faden"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψτε ό,τι έχετε στο μυαλό για να δημιουργήσετε νέο νήμα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write down what’s on your mind to create a new thread"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write down what’s on your mind to create a new thread"
          }
