    "생각과 별개로 조사하거나 정리한 자료를 붙여둘 수 있습니다" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rešerši nebo shrnutí můžete připojit odděleně od vlastních myšlenek"
          }
