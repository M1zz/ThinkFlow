        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aggiungi ogni pensiero separatamente quando cambia il tuo ragionamento, sarà più facile riordinarli dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
