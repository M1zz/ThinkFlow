            "state" : "translated",
            "value" : "Yazı boyutunu büyüttüğünde ekranlar kesilmeden düzgünce yeniden yerleşir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tăng cỡ chữ, màn hình sẽ tự bố trí lại gọn gàng, không bị cắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
