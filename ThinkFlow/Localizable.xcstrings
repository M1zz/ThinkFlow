    "예: \"숏폼이 뇌를 망치는 이유는 보상 주기 때문인데, 그렇다면—\"" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Např.: „Krátká videa ničí soustředění kvůli odměnám, takže pak…“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "F.eks.: “Korte videoer ødelægger koncentrationen på grund af belønningerne, så så…”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "z. B. „Kurzvideos schaden der Konzentration wegen ihrer Belohnungen – also dann …“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Π.χ. «Τα σύντομα βίντεο καταστρέφουν τη συγκέντρωση λόγω των ανταμοιβών, άρα τότε…»"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e.g. “Short videos wear down focus because of how they reward you, so then—”"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e.g. “Short videos wear down focus because of how they reward you, so then—”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ej.: «Los vídeos cortos nos quitan la concentración por cómo nos recompensan, así que entonces…»"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esim. ”Lyhyet videot heikentävät keskittymistä palkitsemisen takia, joten silloin…”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ex. : « Les vidéos courtes nuisent à la concentration à cause de leurs récompenses, alors… »"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contoh: “Video pendek merusak fokus karena sistem hadiahnya, jadi kalau begitu…”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es.: «I video brevi rovinano la concentrazione per come ci premiano, e allora…»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例：「ショート動画が集中力を奪うのは報酬のせいだ。では――」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예: \"숏폼이 뇌를 망치는 이유는 보상 주기 때문인데, 그렇다면—\""
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "F.eks.: «Korte videoer ødelegger konsentrasjonen på grunn av belønningene, så da …»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijv.: “Korte video’s verpesten de concentratie door de beloningen, dus dan…”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Np.: „Krótkie filmy psują koncentrację przez system nagród, więc wtedy…”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ex.: “Vídeos curtos prejudicam a concentração por causa das recompensas, então…”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Например: «Короткие видео вредят концентрации из-за системы поощрений, а значит…»"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T.ex.: ”Korta videor förstör koncentrationen på grund av belöningarna, så då …”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เช่น “คลิปสั้นทำให้สมาธิสั้นลงเพราะระบบให้รางวัล แล้วถ้า…”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Örn. “Kısa videolar ödül sistemi yüzünden dikkati dağıtıyor, o halde…”"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ví dụ: “Video ngắn làm giảm sự tập trung vì cơ chế thưởng, vậy thì…”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
