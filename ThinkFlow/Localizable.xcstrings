    "선택한 것은 바로 생각 스레드가 됩니다. 나머지는 보관됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybraná myšlenka se hned stane vláknem úvah. Ostatní se uloží."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den, du vælger, bliver straks en tankerække. Resten gemmes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Favorit wird sofort zum Gedankenfaden. Der Rest wird aufbewahrt."
