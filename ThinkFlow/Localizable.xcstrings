    "생각과 별개로 조사하거나 정리한 자료를 붙여둘 수 있습니다" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst Recherchen und Zusammenfassungen getrennt von deinen eigenen Gedanken anhängen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attach research or notes separate from your own thinking"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attach research or notes kept separate from your own thinking"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes adjuntar lo que investigaste o resumiste, separado de tus propias ideas"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の考えとは別に、調べたりまとめたりした資料を貼っておけます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생각과 별개로 조사하거나 정리한 자료를 붙여둘 수 있습니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以把调研或整理的资料与自己的想法分开附上"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以把查詢或整理的資料與自己的想法分開附上"
          }
        }
      }
    },
    "생각을 남기거나 이어 갈 때 가볍게 떨려서 알려 줘요." : {
      "comment" : "Roadmap item detail: haptics",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein sanftes Vibrieren, wenn du einen Gedanken festhältst oder fortsetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gentle tap when you jot down or continue a thought."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gentle tap when you jot down or continue a thought."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vibración suave al guardar o retomar una idea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "考えを残したり続けたりするときに、軽い振動でお知らせします。"
          }
