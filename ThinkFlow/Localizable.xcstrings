    "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: colors and contrast",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše přečtete snadno, i se zvýšeným kontrastem nebo při obtížném rozlišování barev."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læs alt let, også med øget kontrast, eller hvis det er svært at skelne farver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles gut lesbar – auch mit höherem Kontrast oder bei Farbschwäche."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαβάστε τα πάντα εύκολα, ακόμα και με αυξημένη αντίθεση ή δυσκολία στη διάκριση χρωμάτων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read everything easily, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read everything easily, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee todo con facilidad, incluso con más contraste o si te cuesta distinguir los colores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lue kaikki helposti, vaikka kontrasti olisi korotettu tai värien erottaminen olisi vaikeaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste lisible, même avec un contraste renforcé ou des difficultés à distinguer les couleurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baca semuanya dengan mudah, bahkan saat kontras ditingkatkan atau sulit membedakan warna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi tutto con facilità, anche con contrasto elevato o se fai fatica a distinguere i colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを高めたり、色の区別がつきにくくても、内容が読み取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 내용을 알아볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alt enkelt, også med økt kontrast eller hvis det er vanskelig å skille farger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees alles gemakkelijk, ook met meer contrast of als kleuren lastig te onderscheiden zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czytaj wszystko bez trudu, nawet przy zwiększonym kontraście lub kłopotach z odróżnianiem kolorów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia tudo com facilidade, mesmo com contraste maior ou dificuldade para distinguir cores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё хорошо читается — даже при повышенной контрастности или трудностях с различением цветов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läs allt med lätthet, även med ökad kontrast eller om det är svårt att skilja på färger."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านเนื้อหาได้ง่าย แม้เปิดเพิ่มคอนทราสต์หรือแยกสีได้ยาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrastı artırdığında ya da renkleri ayırt etmekte zorlandığında bile her şeyi rahatça oku."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẫn đọc rõ nội dung khi tăng độ tương phản hoặc khó phân biệt màu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提高对比度或难以分辨颜色时，内容也依然清晰可辨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提高對比或不易分辨顏色時，內容也依然清晰可辨。"
          }
        }
      }
    },
