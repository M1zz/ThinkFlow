    "멈춘 생각을 이어가세요. 헤밍웨이 브릿지를 홈 화면에서 확인합니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navažte na zastavené myšlenky. Navazující větu uvidíte na ploše."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag tråden op igen, hvor du slap. Se din brosætning på hjemmeskærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach bei angehaltenen Gedanken weiter. Sieh deinen Brückensatz auf dem Home-Bildschirm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνεχίστε τις σκέψεις που σταματήσατε. Δείτε την πρόταση-γέφυρα στην Αρχική οθόνη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick your paused thinking back up. See your bridge sentence on the Home Screen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick your paused thinking back up. See your bridge sentence on the Home Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retoma tus ideas pausadas. Mira tu frase puente en la pantalla de inicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatka pysähtyneitä ajatuksiasi. Näet siltalauseesi kotinäytöllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprenez vos réflexions en pause. Retrouvez votre phrase-relais sur l’écran d’accueil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lanjutkan pikiran yang terhenti. Lihat kalimat jembatanmu di Layar Utama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprendi i pensieri in pausa. Vedi la tua frase ponte nella schermata Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "止まった考えの続きから。区切りの一文をホーム画面で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "멈춘 생각을 이어가세요. 헤밍웨이 브릿지를 홈 화면에서 확인합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta opp tråden der du slapp. Se brosetningen din på hjemskjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pak je onderbroken gedachten weer op. Zie je brugzin op het beginscherm."
