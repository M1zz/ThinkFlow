    "멈춘 생각을 이어가세요. 헤밍웨이 브릿지를 홈 화면에서 확인합니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach bei angehaltenen Gedanken weiter. Sieh deinen Brückensatz auf dem Home-Bildschirm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick your paused thinking back up. See your bridge sentence on the Home Screen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick your paused thinking back up. See your bridge sentence on the Home Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retoma tus ideas pausadas. Mira tu frase puente en la pantalla de inicio."
