        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprenez vos réflexions en pause. Retrouvez votre phrase-relais sur l’écran d’accueil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "止まった考えの続きから。区切りの一文をホーム画面で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "멈춘 생각을 이어가세요. 헤밍웨이 브릿지를 홈 화면에서 확인합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接上中断的思考，在主屏幕查看你的衔接句。"
          }
