    "가장 최근 생각 스레드의 브릿지를 보여줍니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Brückensatz deines neuesten Gedankenfadens."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the bridge of your most recent thought thread."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the bridge of your most recent thought thread."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la frase puente de tu hilo más reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la phrase-relais de votre fil le plus récent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新の思考スレッドの区切りの一文を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 최근 생각 스레드의 브릿지를 보여줍니다."
